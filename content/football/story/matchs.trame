// ═══════════════════════════════════════════════════════════════════════
//  MATCHS — match hebdomadaire + réserve de « moments » interactifs
// ═══════════════════════════════════════════════════════════════════════

=== match_semaine
titre: Jour de match
declencheur: tick_end
quand: var.saison et non var.match_joue
priorite: 50
---
~ var.match_joue = vrai
si var.blesse > 0
  > Blessé, tu suis le match de {var.club} depuis les tribunes.
  ~ var.score_nous = poisson(1.3); var.score_eux = poisson(1.2)
  > Score final : {var.score_nous}–{var.score_eux}.
  -> fin
si var.suspendu > 0
  ~ var.suspendu -= 1
  > Suspendu, tu regardes tes coéquipiers depuis la tribune. Long, très long.
  ~ var.score_nous = poisson(1.2); var.score_eux = poisson(1.3); stat.moral -= 4; stat.forme -= 3
  > Score final : {var.score_nous}–{var.score_eux}.
  -> fin
~ var.adv = listeHasard("adversaires_" + var.ligue)
~ var.adversaire = liste("adversaires_" + var.ligue, var.adv, "nom"); var.adv_court = liste("adversaires_" + var.ligue, var.adv, "court"); var.adv_force = liste("adversaires_" + var.ligue, var.adv, "force"); var.adv_couleur = liste("adversaires_" + var.ligue, var.adv, "couleur")
~ var.score_nous = 0; var.score_eux = 0; var.minute = 0; var.note_match = 6
~ var.titulaire = stat.statut + stat.forme / 3 + hasard(0, 18) >= 62
~ var.domicile = chance(50)
!lieu stade 320 {var.domicile ? "nuit" : "jour"}
!equipe nous {var.club_couleur} {var.club_couleur2} #ffffff {var.club_couleur}
!equipe eux {var.adv_couleur} #ffffff #25222b {var.adv_couleur}
!fx foule {var.stade_taille >= 3 ? 0.8 : 0.45}
si var.domicile
  > {var.club} reçoit {var.adversaire}.
sinon
  > {var.club} se déplace chez {var.adversaire}.
si var.titulaire
  ~ var.titularisations += 1
  > Tu es titulaire.
sinon
  > Tu démarres sur le banc.
!son sifflet
tirer moment {var.titulaire ? 3 : 1}
~ var.minute = 90
~ var.score_nous += poisson(max(0.2, 0.85 + (var.force_equipe - var.adv_force) / 45))
~ var.score_eux += poisson(max(0.2, 0.85 + (var.adv_force - var.force_equipe) / 45))
!ballon cacher
!son sifflet
si var.score_nous > var.score_eux
  !fx foule 0.9
  !anim moi joie
  > Victoire {var.score_nous}–{var.score_eux} !
  ~ stat.moral += 6; var.victoires += 1; stat.statut += 1
sinon si var.score_nous == var.score_eux
  > Match nul, {var.score_nous}–{var.score_eux}.
sinon
  !anim moi triste
  > Défaite {var.score_nous}–{var.score_eux}.
  ~ stat.moral -= 5
~ var.matchs += 1; var.notes_total += var.note_match
~ stat.forme += arrondi((var.note_match - 6) * 5); stat.statut += arrondi((var.note_match - 6) * 2.5); stat.energie -= var.titulaire ? 20 : 8
~ stat.reputation += var.note_match >= 7.5 ? 2 : var.note_match >= 6.8 ? 1 : 0
~ stat.notoriete += var.note_match >= 8 ? 2 : 0
~ stat.confiance += var.note_match >= 7 ? 3 : var.note_match < 5.5 ? -3 : 0
> Ta note : {arrondi(var.note_match * 10) / 10}/10.
!anim moi idle
!fx foule 0.3

// ── Moments de match ───────────────────────────────────────────────────

=== mo_face_a_face
titre: Face au gardien
declencheur: pool:moment
poids: joueur.poste == 'attaquant' ? 4 : joueur.poste == 'milieu' ? 1.5 : 0.4
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset face_a_face
!camera moi
> {var.minute}e minute. Une ouverture lumineuse te lance seul face au gardien !
* Frapper en force #frappe
  test stat.frappe + stat.forme / 5 vs 60
  !anim moi frappe
  !son frappe
  si reussite
    !ballon vers but tir
    -> but
  sinon
    !anim gk plongeon
    !ballon vers gk tir
    > Le gardien repousse du bout des gants !
    ~ var.note_match -= 0.3
* Dribbler le gardien #technique
  test stat.technique + stat.confiance / 5 vs 62
  si reussite
    !courir moi 575
    !anim gk plongeon
    !ballon vers but passe
    -> but
  sinon
    !anim gk plongeon
    !ballon vers gk passe
    > Le gardien plonge dans tes pieds.
    ~ var.note_match -= 0.4; stat.confiance -= 2
* Piquer le ballon par-dessus #artiste
  test stat.technique + stat.mental / 4 vs 68
  !anim moi frappe
  si reussite
    !ballon vers but lob
    ~ stat.notoriete += 2
    -> but
  sinon
    !ballon vers dessus lob
    > Trop long. Le public siffle.
    ~ var.note_match -= 0.5; stat.confiance -= 3
-> fin

@but
!fx filet
!son but
!fx foule 1
!titre BUT !
!anim moi joie
~ var.score_nous += 1; var.buts += 1; var.note_match += 1.2; stat.confiance += 4
> Tu marques ! {var.club_court} {var.score_nous}–{var.score_eux}.
appel celebration

=== celebration
titre: Célébration
declencheur: manual
---
si chance(45)
  > Comment célèbres-tu ?
  * Courir vers le banc et le coach #collectif
    ~ stat.statut += 2
    [var.club_id == rivemont] ~ rel.moreau += 2
  * Sauter dans les bras des supporters #fans
    ~ stat.reputation += 1; stat.notoriete += 1
  * Un cœur avec les doigts, pour la famille #famille
    ~ rel.maman += 3; rel.yanis += 3
  * [rel.ines >= 25] Un clin d'œil vers la tribune, pour Inès
    ~ rel.ines += 4
  * Chambrer les supporters adverses #provoc
    ~ stat.notoriete += 2; stat.discipline -= 3; stat.reputation -= 1
!fx foule 0.5

=== mo_tete_centre
titre: Centre dans la surface
declencheur: pool:moment
poids: joueur.poste == 'milieu' ? 1 : 2.5
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset centre
!camera moi
> {var.minute}e minute. Le centre arrive au second poteau…
!ballon vers moi centre
* Reprise de la tête #physique
  test (stat.physique + stat.frappe) / 2 + stat.forme / 6 vs 58
  !anim moi tete
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.1; stat.confiance += 4
    > Coup de casque imparable !
    appel celebration
  sinon
    !ballon vers dessus tir
    > Ta tête frôle le montant.
    ~ var.note_match -= 0.2
* Remise en retrait pour un coéquipier #collectif
  test stat.passe vs 50
  !ballon vers co1 passe
  si reussite
    !anim co1 frappe
    !ballon vers but tir
    !fx filet
    ~ var.score_nous += 1; var.passes_d += 1; var.note_match += 0.8
    > Ta remise est parfaite : but ! Passe décisive pour toi.
  sinon
    > La remise est contrée.
* Tenter un retourné acrobatique #artiste
  test stat.technique + stat.physique / 4 vs 74
  !anim moi saut
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre RETOURNÉ !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.6; stat.notoriete += 5; stat.reputation += 2
    > Un retourné dans la lucarne. Les réseaux vont tourner en boucle.
  sinon
    !anim moi chute
    > Tu tombes sur le dos, le ballon file en touche.
    ~ var.note_match -= 0.4; stat.sante -= 3

=== mo_passe_decisive
titre: La passe qui tue
declencheur: pool:moment
poids: joueur.poste == 'milieu' ? 4 : 1.5
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset milieu
!camera moi
> {var.minute}e minute. Tu lèves la tête : un appel en profondeur, un autre dans l'intervalle.
* Passe en profondeur dans la course #passe
  test stat.passe + stat.mental / 5 vs 58
  !ballon vers co2 passe
  si reussite
    !courir co2 560
    !anim co2 frappe
    !ballon vers but tir
    !fx filet
    !son but
    ~ var.score_nous += 1; var.passes_d += 1; var.note_match += 1.0
    > Passe lumineuse : but ! Le buteur pointe du doigt vers toi.
  sinon
    > Un poil trop longue. Le gardien sort au pied.
    ~ var.note_match -= 0.2
* Une-deux puis frapper #frappe
  test stat.technique / 2 + stat.frappe / 2 + stat.forme / 6 vs 60
  !ballon vers co1 passe
  !ballon vers moi passe
  !anim moi frappe
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.1
    > Une-deux, frappe croisée : but !
    appel celebration
  sinon
    !ballon vers gk tir
    > Le gardien capte sans trembler.
* Conserver et faire remonter le bloc #prudent
  ~ var.note_match += 0.2
  > Tu ralentis le jeu. L'équipe respire.

=== mo_frappe_lointaine
titre: À trente mètres
declencheur: pool:moment
poids: 2
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset milieu
!camera moi
> {var.minute}e minute. Le ballon traîne devant toi, à trente mètres. Personne ne sort.
* Frapper ! #frappe
  test stat.frappe + stat.confiance / 5 vs 66
  !anim moi frappe
  !son frappe
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.4; stat.reputation += 1
    > Une mine sous la barre !
    appel celebration
  sinon
    !ballon vers dessus tir
    > Dans les tribunes. Un supporter récupère le ballon en souvenir.
    ~ var.note_match -= 0.2
* Avancer et chercher mieux #collectif
  test stat.passe vs 50
  !ballon vers co1 passe
  si reussite
    ~ var.note_match += 0.4
    > Tu attires deux défenseurs et libères ton partenaire.
  sinon
    > La passe est coupée.

=== mo_tacle_decisif
titre: Le dernier rempart
declencheur: pool:moment
poids: joueur.poste == 'defenseur' ? 4 : 1
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset defense
!camera att1
> {var.minute}e minute. Un attaquant adverse file au but. Tu es le dernier défenseur.
* Tacle glissé #defense
  test stat.defense + stat.physique / 4 vs 58
  !anim moi tacle
  si reussite
    !ballon vers moi passe
    > Tacle parfait, ballon récupéré ! Le stade se lève.
    ~ var.note_match += 0.8; stat.confiance += 3
  sinon
    !anim att1 chute
    > Tu arrives en retard. Faute… et carton jaune.
    ~ var.note_match -= 0.6; var.cartons += 1
    si chance(30)
      > Le coup franc qui suit finit au fond.
      ~ var.score_eux += 1
* Le pousser vers l'extérieur #prudent
  test stat.defense + stat.mental / 4 vs 52
  si reussite
    > Tu l'obliges à frapper d'un angle impossible. Le gardien capte.
    ~ var.note_match += 0.5
  sinon
    !ballon vers but_gauche tir
    !fx filet
    > Il ajuste ton gardien d'un tir croisé.
    ~ var.score_eux += 1; var.note_match -= 0.5
* Faute volontaire, tant pis #cynique
  !anim moi tacle
  !anim att1 chute
  > Tu le fauches. Carton jaune, mais l'action est cassée.
  ~ var.note_match -= 0.1; var.cartons += 1; stat.discipline -= 1

=== mo_duel_aerien
titre: Duel aérien
declencheur: pool:moment
poids: joueur.poste == 'defenseur' ? 3 : 0.6
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset defense
> {var.minute}e minute. Corner adverse. Leur géant se place juste devant toi.
* Monter au duel de toutes tes forces #physique
  test stat.physique + stat.defense / 3 vs 60
  !anim moi tete
  si reussite
    > Tu domines le géant. Dégagement de la tête.
    ~ var.note_match += 0.6
  sinon
    !ballon vers but_gauche tir
    !fx filet
    > Il te devance. But adverse.
    ~ var.score_eux += 1; var.note_match -= 0.6
* Anticiper et couper la trajectoire #mental
  test stat.mental + stat.defense / 3 vs 58
  si reussite
    > Tu lis le corner avant tout le monde et interceptes.
    ~ var.note_match += 0.7
  sinon
    > Tu te fais piéger par un corner rentrant. Le ballon passe devant toi ; heureusement, il sort.

=== mo_corner_offensif
titre: Corner offensif
declencheur: pool:moment
poids: joueur.poste == 'defenseur' ? 3 : 1
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset corner
!camera moi
> {var.minute}e minute. Corner pour vous. Le coach te fait signe de monter.
!ballon vers moi centre
* Attaquer le premier poteau #physique
  test stat.physique + stat.frappe / 3 vs 62
  !anim moi tete
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.3; stat.reputation += 1
    > Tête rageuse au premier poteau !
    appel celebration
  sinon
    !ballon vers dessus tir
    > Ta tête passe juste au-dessus.
* Dévier pour un partenaire #collectif
  test stat.passe + stat.mental / 4 vs 56
  si reussite
    ~ var.score_nous += 1; var.passes_d += 1; var.note_match += 0.8
    !fx filet
    > Ta déviation trouve un partenaire au second poteau : but !
  sinon
    > Ta déviation finit dans les bras du gardien.

=== mo_relance
titre: Sous le pressing
declencheur: pool:moment
poids: joueur.poste == 'defenseur' ? 2.5 : 0.8
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset defense
!ballon pied moi
> {var.minute}e minute. Tu récupères le ballon devant ta surface. Deux adversaires te pressent.
* Relance courte et propre #passe
  test stat.passe + stat.mental / 4 vs 54
  !ballon vers co1 passe
  si reussite
    > Tu casses le pressing d'une passe. L'équipe ressort proprement.
    ~ var.note_match += 0.5
  sinon
    !ballon vers but_gauche tir
    !fx filet
    > Passe interceptée… et but. Le silence est terrible.
    ~ var.score_eux += 1; var.note_match -= 0.9; stat.confiance -= 5
* Dégager loin #prudent
  !anim moi frappe
  !ballon vers 500 lob
  > Pas joli, mais efficace.
  ~ var.note_match += 0.1
* Éliminer le premier attaquant d'un crochet #artiste
  test stat.technique + stat.confiance / 4 vs 60
  si reussite
    !courir moi 220
    > Un crochet dans ta propre surface. Le coach a failli faire un malaise… mais ça passe, et le public adore.
    ~ var.note_match += 0.7; stat.notoriete += 1
  sinon
    !ballon vers but_gauche tir
    !fx filet
    > Ballon perdu, but encaissé.
    ~ var.score_eux += 1; var.note_match -= 1; stat.statut -= 3

=== mo_coup_franc
titre: Coup franc
declencheur: pool:moment
quand: var.tireur_cf ou stat.technique >= 55
poids: 1.5
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset coup_franc
!camera moi
> {var.minute}e minute. Coup franc à vingt-deux mètres. Tu poses le ballon.
* Enroulé, au-dessus du mur #technique
  test stat.technique + stat.frappe / 3 vs 68
  !anim moi frappe
  si reussite
    !ballon vers but lob
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.4; stat.reputation += 2
    > Lucarne. Le gardien n'a pas bougé.
    appel celebration
  sinon
    !ballon vers dessus lob
    > Au-dessus.
* En force, sous le mur #frappe
  test stat.frappe vs 64
  !anim moi frappe
  !son frappe
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.3
    > Le mur saute, le ballon file dessous !
    appel celebration
  sinon
    !ballon vers mur1 tir
    > Dans le mur.

=== mo_penalty
titre: Penalty
declencheur: pool:moment
quand: joueur.poste != defenseur ou stat.frappe >= 50
poids: 0.8
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset penalty
!camera moi
> {var.minute}e minute. Penalty ! Tu prends le ballon. Personne ne te le conteste.
* Côté ouvert, en force #frappe
  test stat.frappe + stat.mental / 3 vs 62
  !anim moi frappe
  !son frappe
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.0
    > Transformé !
  sinon
    !anim gk plongeon
    !ballon vers gk tir
    > Arrêté !
    ~ var.note_match -= 0.8; stat.confiance -= 6
* Panenka #artiste
  test stat.technique + stat.confiance / 2 vs 76
  !anim moi passe
  si reussite
    !anim gk plongeon
    !ballon vers but lob
    !fx filet
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.2; stat.notoriete += 4
    > Une Panenka. Culotté. Le stade en redemande.
  sinon
    !ballon vers gk lob
    > Le gardien n'a pas bougé. Il cueille ton ballon. Humiliation.
    ~ var.note_match -= 1.2; stat.confiance -= 10; stat.notoriete += 1
* Laisser le tireur désigné #prudent
  test 60 vs 50
  si reussite
    !fx filet
    ~ var.score_nous += 1
    > Il transforme.
  sinon
    > Il manque. Ça aurait pu être toi.

=== mo_egoisme
titre: Seul contre tous ?
declencheur: pool:moment
poids: 2
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset attaque
!camera moi
> {var.minute}e minute. Tu es lancé, un coéquipier est démarqué à ta gauche… mais tu as un angle de frappe.
* Servir le coéquipier #collectif
  test stat.passe vs 48
  !ballon vers co1 passe
  si reussite
    !anim co1 frappe
    !ballon vers but tir
    !fx filet
    ~ var.score_nous += 1; var.passes_d += 1; var.note_match += 0.8; stat.statut += 1
    > But ! Il court te serrer dans ses bras.
  sinon
    > Ta passe est contrée.
* Frapper quand même #individuel
  test stat.frappe + stat.confiance / 4 vs 64
  !anim moi frappe
  !son frappe
  si reussite
    !ballon vers but tir
    !fx filet
    !son but
    !titre BUT !
    ~ var.score_nous += 1; var.buts += 1; var.note_match += 1.0
    > Ça rentre ! Ton coéquipier applaudit… du bout des doigts.
    appel celebration
  sinon
    !ballon vers dessus tir
    > Raté. Ton coéquipier lève les bras au ciel. Le banc aussi.
    ~ var.note_match -= 0.6; stat.statut -= 3

=== mo_provocation
titre: Provocation
declencheur: pool:moment
poids: 1.2
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset milieu
!emote adv1 colere
> {var.minute}e minute. Ton vis-à-vis t'insulte depuis le début. Il vient de te marcher sur la cheville, exprès.
* L'ignorer et jouer #mental
  ~ stat.mental += 1; var.note_match += 0.2
  > Tu souris. Ça l'énerve encore plus. Il finit averti.
* Lui répondre, nez à nez #impulsif
  test stat.mental vs 55
  si reussite
    > Un échange de regards. L'arbitre vous sépare. Rien de plus.
  sinon
    > Tu le pousses. Carton rouge. Le chemin du vestiaire est très long.
    ~ var.note_match -= 2; var.suspendu += 1; stat.statut -= 8; stat.discipline -= 6; var.cartons += 1
    -> fin
* Le provoquer en retour, en le dribblant #artiste
  test stat.technique vs 58
  si reussite
    > Petit pont. Il s'arrache les cheveux. Le public jubile.
    ~ var.note_match += 0.5; stat.notoriete += 1
  sinon
    > Tu perds le ballon. Il rigole.
    ~ var.note_match -= 0.3

=== mo_choc
titre: Le choc
declencheur: pool:moment
poids: 0.6 + var.genou * 0.4 + (stat.energie < 30 ? 1 : 0)
---
~ var.minute = min(88, var.minute + hasard(10, 28))
!preset milieu
!anim adv1 tacle
!anim moi chute
> {var.minute}e minute. Un tacle par derrière. Tu restes au sol, la cheville en feu.
* Serrer les dents et continuer #courage
  test stat.physique + stat.sante / 4 vs 60
  si reussite
    > La douleur s'estompe. Tu finis le match.
    ~ var.note_match += 0.2; stat.sante -= 6
  sinon
    > Tu finis en boitant. Le lendemain, ta cheville a doublé de volume.
    ~ var.blesse = 2; var.blessures += 1; var.genou += 1; stat.sante -= 15
    ~ actu("Blessé à la cheville, tu seras absent deux semaines.")
* Demander le changement #prudent
  > Tu sors sous les applaudissements. Bruno pose de la glace : rien de grave.
  ~ stat.sante -= 3; var.note_match -= 0.2
