{
  "name": "mille-vies",
  "version": "0.1.0",
  "private": true,
  "description": "Mille Vies — moteur de jeux narratifs 2D pixel art (univers, choix, conséquences, éditeur intégré)",
  "type": "module",
  "scripts": {
    "content": "tsx tools/build-content.ts",
    "build": "tsx tools/build-content.ts && node tools/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsx tools/build-content.ts && tsc --noEmit",
    "simulate": "tsx tools/simulate.ts"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.1.0",
    "@fontsource/silkscreen": "^5.1.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
