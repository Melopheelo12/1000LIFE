// ═══════════════════════════════════════════════════════════════════════
//  CLUBS — « fonctions » appelées par les scripts (appel club_xxx)
//  Chaque club définit son identité visuelle, son niveau et son entraîneur.
// ═══════════════════════════════════════════════════════════════════════

=== club_rivemont
titre: Club : Stade Rivemont
declencheur: manual
---
~ var.club = "Stade Rivemont"; var.club_id = "rivemont"; var.club_court = "SR"; var.club_couleur = "#1f4e9c"; var.club_couleur2 = "#f2c230"; var.stade_nom = "Stade des Cerisiers"; var.ville = "Rivemont"; var.coach_nom = "Didier Moreau"; var.club_etranger = faux; var.ligue = "d1"; var.stade_taille = 2; var.force_equipe = 62

