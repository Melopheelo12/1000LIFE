 "activities": [
  {
   "id": "ecrire",
   "label": "Écrire des textes",
   "description": "Le carnet, un stylo, et cette phrase qui tourne depuis ce matin.",
   "cost": {
    "actions": 1,
    "energie": 10
   },
   "effects": "stat.plume += hasard(1, 3); var.textes += 1; stat.moral += 1",
   "feedback": "Une page de plus. Tu barres la moitié, tu gardes le meilleur."
  },
  {
   "id": "poster",
   "label": "Poster un extrait",
   "description": "Trente secondes face caméra, un couplet, et le monde entier comme public.",
   "cost": {
    "actions": 1
   },
   "effects": "var.abonnes += hasard(10, 40) + stat.hype * 4 + var.sons * 15; stat.hype += chance(40) ? 1 : 0",
   "feedback": "Les premières vues tombent. Tu rafraîchis toutes les deux minutes.",
   "maxPerTick": 1
  },
  {
   "id": "classiques",
   "label": "Réécouter les classiques",
   "description": "Les albums qui t'ont appris à écrire, casque vissé sur les oreilles.",
   "cost": {
    "actions": 1
   },
   "effects": "stat.plume += hasard(0, 1); stat.flow += hasard(0, 2); stat.moral += 2",
   "feedback": "Tu rembobines le même couplet dix fois. Comment il a fait ça ?"
  },
  {
   "id": "freestyle",
   "label": "Freestyler au banc",
   "description": "Momo tape un beat sur le banc, les potes font cercle.",
   "cost": {
    "actions": 1,
    "energie": 10
   },
   "effects": "stat.flow += hasard(1, 3); stat.respect += 1; var.freestyles += 1",
   "feedback": "Les potes crient sur ta dernière rime. Le quartier t'écoute."
  },
  {
   "id": "prod",
   "label": "Bosser une prod avec Momo",
   "description": "Choisir les samples, caler la rythmique, se disputer sur la caisse claire.",
   "cost": {
    "actions": 1,
    "energie": 10
   },
   "effects": "stat.flow += hasard(0, 1); stat.plume += hasard(0, 1); rel.momo += 2; var.prods += 1",
   "feedback": "À deux heures du matin, la prod tourne enfin. Momo hoche la tête en rythme.",
   "when": "non var.momo_parti",
   "lockedText": "Momo ne vient plus au studio."
  },
  {
   "id": "enregistrer",
   "label": "Enregistrer un morceau",
   "description": "Casque, micro, une prise. Puis une autre. Puis encore une.",
   "cost": {
    "actions": 1,
    "energie": 15
   },
   "effects": "var.sons += 1; stat.flow += 1; stat.hype += hasard(0, 1); var.abonnes += 20 + stat.hype * 2",
   "feedback": "Le morceau est dans la boîte. Tu le réécoutes en boucle sur le chemin du retour.",
   "when": "var.textes > var.sons et var.studio_ferme == 0",
   "lockedText": "Il te faut un texte fini de plus que de morceaux enregistrés (écris dans ta chambre), et un studio ouvert.",
   "maxPerTick": 1
  },
  {
   "id": "open_mic",
   "label": "Monter sur scène à l'open mic",
   "description": "Ton nom sur la liste, le micro chaud, trente paires d'yeux.",
   "cost": {
    "actions": 1,
    "energie": 15
   },
   "effects": "stat.scene += hasard(1, 3); stat.hype += hasard(0, 2); stat.respect += 1; var.open_mics += 1; var.abonnes += 10 + stat.scene",
   "feedback": "Les applaudissements te suivent jusqu'au bar."
  },
  {
   "id": "reseauter",
